# Fichier d'exemple pour l'environnement Pre-Production (pprod)
# Copier ce fichier vers .envs/.env.pprod et remplir avec les vraies valeurs

# ====================================
# APPLICATION
# ====================================
NUXT_PUBLIC_PROFILE_ENV=pprod
NUXT_BASIC_AUTH=false
NUXT_COOKIE_NAME=siseb.pprod

# ====================================
# BETTER AUTH
# ====================================
# URL de base de l'application (utilisée par Better Auth)
BETTER_AUTH_URL=http://siseb-refonte.emes.bj

# URL publique pour le client (peut être la même que BETTER_AUTH_URL)
NUXT_PUBLIC_BETTER_AUTH_URL=http://siseb-refonte.emes.bj

# Secret pour Better Auth (GÉNÉRER UN SECRET FORT !)
# Commande pour générer : openssl rand -base64 32
BETTER_AUTH_SECRET=REMPLACER_PAR_UN_SECRET_FORT

# ====================================
# KEYCLOAK
# ====================================
KEYCLOAK_URL=https://keycloack.emes.bj
KEYCLOAK_REALM=siseb
KEYCLOAK_CLIENT_ID=siseb-front
KEYCLOAK_CLIENT_SECRET=REMPLACER_PAR_LE_SECRET_KEYCLOAK

# ====================================
# API BACKEND SISEB
# ====================================
NUXT_PUBLIC_SISEB_API_BASE_URL=https://siseb-refonte.emes.bj/api
NUXT_PUBLIC_SISEB_API_STATS_BASE_URL=https://siseb-refonte.emes.bj/stat-module/api

# ====================================
# NOTES
# ====================================
# 1. Ne JAMAIS commiter ce fichier avec des vraies valeurs
# 2. Générer des secrets forts pour BETTER_AUTH_SECRET
# 3. En production, utiliser HTTPS au lieu de HTTP
# 4. S'assurer que les URLs sont accessibles depuis Docker
